# Convex. Both values are written into .env.local automatically when you run
# `npx convex dev` for the first time (it walks you through login and creating
# the project). For production, set NEXT_PUBLIC_CONVEX_URL in your host's
# environment settings and deploy functions with `npx convex deploy`.

# The deployment your local `convex dev` pushes functions to. Local dev only.
CONVEX_DEPLOYMENT=

# The public URL of your Convex deployment, e.g. https://something-123.convex.cloud
# Required for the forms to save to the database. Without it, the forms fall
# back to opening an email draft.
NEXT_PUBLIC_CONVEX_URL=
